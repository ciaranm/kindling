#!/usr/bin/env python3
"""Launcher for the MiniZinc backend.  Finds the repository from its own
location, so nothing has to be installed and nothing has to be on a path."""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from kindling.backend import main  # noqa: E402

raise SystemExit(main(sys.argv[1:]))
